# Application
APP_NAME="AI Agent Workspace 24/7"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:3000

# Frontend
FRONTEND_PORT=3000

# Backend
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000

# Worker
WORKER_CONCURRENCY=1
WORKER_QUEUE_NAME=agent-jobs

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=planner_workspace
POSTGRES_USER=planner
POSTGRES_PASSWORD=planner_password
DATABASE_URL=postgresql://planner:planner_password@postgres:5432/planner_workspace

# Cache / Queue
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# AI Provider
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Security
JWT_SECRET=change-me-in-local-env
ENCRYPTION_KEY=change-me-in-local-env

# Observability
LOG_LEVEL=info
