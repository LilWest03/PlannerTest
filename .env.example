# Shared
PROJECT_NAME=ai-agent-workspace-student
APP_ENV=development
LOG_LEVEL=info

# Frontend
FRONTEND_PORT=3000
DEMO_USER_EMAIL=demo@mahasiswa.local
DEMO_USER_PASSWORD=demo12345
DEMO_USER_NAME=Demo Mahasiswa

# Backend
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
API_PREFIX=/api/v1
JWT_SECRET=change-me
STORAGE_MODE=local
STORAGE_PATH=storage/documents

# Worker
WORKER_CONCURRENCY=2

# Database
POSTGRES_DB=student_workspace
POSTGRES_USER=student_workspace
POSTGRES_PASSWORD=student_workspace
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://student_workspace:student_workspace@postgres:5432/student_workspace

# Cache / Queue
REDIS_PORT=6379
